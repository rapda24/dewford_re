{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dewford-re",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://rapda24.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dewford-db",
      // Replace with the ID returned by `npx wrangler d1 create dewford-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
