{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dewford-re",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "vars": {
    "ADMIN_USERNAME": "admin",
    "ALLOWED_ORIGINS": "https://rapda24.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dewford-db",
      "database_id": "b8589514-c4e5-4205-ab02-da6cfb65fe5a",
      "migrations_dir": "migrations"
    }
  ]
}
